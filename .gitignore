node_modules/
dist/
coverage/
.DS_Store
Thumbs.db
*.log

src-tauri/target/
src-tauri/gen/

.venv/
.venv-*/
server/.venv/
server/.mypy_cache/
server/.pytest_cache/
# uv-generated lockfile from local test runs; not tracked upstream.
server/uv.lock

# Python bytecode caches at any depth
**/__pycache__/
*.py[cod]
*$py.class

*.db
*.db-shm
*.db-wal

# Never commit real financial data. Ignore all CSVs by default…
*.csv
# …but allow the repo's legitimate tracked CSVs (test/template/tracker data only):
!server/tests/**/*.csv
!server/templates/*.csv
!docs/*.csv
# Set-aside inputs never belong in the repo:
_superseded_inputs/

# Build debris that should never have been committed:
.tmp/
*.timestamp-*.mjs
